# Template file for 'botui'
pkgname=botui
version=0.1.11
revision=1
build_style=cargo
make_build_args="-p botui"
make_check_args="--workspace"
hostmakedepends="cmake python3"
depends="ca-certificates djvulibre poppler poppler-glib python3-gobject xdg-utils"
short_desc="Terminal ebook reader for local libraries, BookOrbit and OPDS"
maintainer="Stefan <s@omfm.ru>"
license="GPL-3.0-or-later"
homepage="https://github.com/gAlleb/botui"
changelog="https://github.com/gAlleb/botui/releases"
distfiles="https://codeload.github.com/gAlleb/botui/tar.gz/refs/tags/v${version}>${pkgname}-${version}.tar.gz"
checksum=b56e737aac6f1839390ede63ad4f4205bae9c57c8020dac8fe5c23a5409cc3d1

post_extract() {
	# The navigation-test fix is already upstream starting with 0.1.9.
	if [ "$version" = "0.1.8" ]; then
		patch -Np1 < "${FILESDIR}/isolated-navigation-tests.patch"
	fi
}

do_install() {
	vbin target/${RUST_TARGET}/release/botui
	vsconf config.example.toml
}
