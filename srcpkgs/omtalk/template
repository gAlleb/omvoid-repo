pkgname=omtalk
version=0.1.15
revision=1
build_style=cargo
make_build_args="-p omtalk"
# The default feature set excludes the tests that need a running XMPP server.
make_check_args="-p omtalk"
hostmakedepends="cmake pkg-config"
makedepends="opus-devel sqlite-devel"
